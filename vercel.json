{
  "framework": null,
  "installCommand": "npm install && npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/out",
  "trailingSlash": true,
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "server/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/api/:path*/", "destination": "/api" }
  ]
}
