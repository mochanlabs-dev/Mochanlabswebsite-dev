{
  "framework": null,
  "installCommand": "npm install && npm install --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/out",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*/",
      "destination": "/api"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    }
  ]
}
